# Copy to .env only for Docker Compose. start-demo.ps1 manages its own .local settings.
POSTGRES_DB=quedrink
POSTGRES_USER=quedrink
POSTGRES_PASSWORD=
JWT_SECRET=
PAYMENT_CALLBACK_SECRET=
ADMIN_EMAIL=admin@quedrink.local
ADMIN_PASSWORD=
ASPNETCORE_ENVIRONMENT=Development
AUTH_EXPOSE_RESET_TOKEN=false
STORE_NAME=Quê Drinks
STORE_ADDRESS=Nhận tại quầy Quê Drinks - liên hệ quán để biết địa chỉ
STORE_PHONE=
SHIPPING_FEE=10000
SHIPPING_FREE_FROM=150000
FRONTEND_URL=http://localhost:3000
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000

# Gmail SMTP: create an App Password after enabling Google 2-Step Verification.
GMAIL_ENABLED=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# MOCK is Development only. Use DISABLED until your own VNPAY keys are available.
PAYMENT_PROVIDER=MOCK
VNPAY_SANDBOX=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
TRUSTED_PROXY_IPS=
